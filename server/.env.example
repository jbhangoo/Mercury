# Copy this file to .env and fill in the database values when PostGIS is ready.

FLASK_ENV=development
FLASK_DEBUG=1
DEBUG=1

# Set to 1 to use the PostGIS database; set to 0 to mock database responses.
USE_DATABASE=0

# Mercury DB parameters
MERCURY_DB_HOST=localhost
MERCURY_DB_PORT=5432
MERCURY_DB_NAME=mercury
MERCURY_DB_USER=mercury_user
MERCURY_DB_PASSWORD=mercury_pass

# SQLAlchemy's psycopg 3 dialect
DATABASE_URL=postgresql+psycopg://${MERCURY_DB_USER}:${MERCURY_DB_PASSWORD}@${MERCURY_DB_HOST}:${MERCURY_DB_PORT}/${MERCURY_DB_NAME}

# Origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
